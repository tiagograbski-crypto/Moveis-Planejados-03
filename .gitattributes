# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Scripts
*.js text eol=lf
*.ps1 text eol=lf
*.bat text eol=crlf

# Web
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf

# Config
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf

# Images (binary)
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
